# Copy this file to .env and fill it in. Never commit .env or share these values.

# --- Server -----------------------------------------------------------------
PORT=3000
# The public address of the site. Used in emails and for Stripe's return links. Must be https:// in production.
PUBLIC_URL=http://localhost:3000
NODE_ENV=development
# Long random string (32+ chars). Generate one with:  node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SECRET_KEY=
# Set to 1 if the site runs behind a proxy/load balancer (Render, Fly, nginx...), so real visitor IPs are used for rate limits.
TRUST_PROXY=0
# Where the database and uploaded images live. Must be a persistent disk/volume in production and backed up.
DATA_DIR=data

# --- Shop -------------------------------------------------------------------
SHOP_NAME=Rasch o Q Design
SHOP_ADDRESS=Föreningsgatan 5, 211 44 Malmö
STORE_CURRENCY=SEK
# Shipping per country, in whole currency units. Only countries listed here can order.
SHIPPING_RATES=SE:99,DK:149,NO:199,FI:149,DE:199
# Free shipping when the items total reaches this amount (0 = never free)
FREE_SHIPPING_OVER=0
MAX_QTY_PER_LINE=10
LOW_STOCK_THRESHOLD=2
# Checkout attempts allowed per visitor IP per 10 minutes
CHECKOUT_RATE_LIMIT=30

# --- Payments (Stripe) ------------------------------------------------------
# Leave empty to run without online payment: orders are saved as unpaid and you confirm payment in the admin.
STRIPE_SECRET_KEY=
# From Stripe Dashboard > Developers > Webhooks (endpoint: PUBLIC_URL/api/webhooks/stripe)
STRIPE_WEBHOOK_SECRET=
# Text shown to customers when Stripe is NOT connected (manual payment)
MANUAL_PAYMENT_INSTRUCTIONS_SV=Vi återkommer via e-post med betalningsinstruktioner. Beställningen är reserverad åt dig under tiden.
MANUAL_PAYMENT_INSTRUCTIONS_EN=We will email you payment instructions. Your order is reserved for you in the meantime.

# --- Email (Resend, https://resend.com) --------------------------------------
# Leave empty to skip sending emails (they are logged as "skipped" on each order).
RESEND_API_KEY=
# A sender on a domain you have verified in Resend, e.g.  Rasch o Q Design <order@yourdomain.se>
MAIL_FROM=
# Optional: get an email to yourself for every new order
ORDER_NOTIFY_EMAIL=

# --- Housekeeping -----------------------------------------------------------
# Unpaid online-payment orders older than this release their reserved stock automatically
UNPAID_ORDER_TTL_MINUTES=45
SWEEP_INTERVAL_SECONDS=60
